// Weekly Table data model.
// See ~/.claude/plans/i-want-to-build-expressive-wall.md for the full design rationale.
//
// Deliberately absent by design (see the plan's "Explicitly out of scope"):
// no Customer/Account/Subscription tables, no per-dish price field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending_payment
  paid
  fulfilled
  cancelled
}

enum PaymentMethod {
  stripe
  cash
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

model Dish {
  id          String  @id @default(uuid())
  name        String  @unique
  category    String
  dietaryTag  String?
  description String
  imageUrl    String
  isActive    Boolean @default(true)

  // Which days of the week this dish can be delivered on — not every dish
  // is cooked every day. Defaults to every day so existing/new dishes stay
  // orderable unless an admin deliberately narrows this.
  availableDays Weekday[] @default([monday, tuesday, wednesday, thursday, friday, saturday, sunday])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id        String  @id @default(uuid())
  label     String
  mealCount Int
  priceGbp  Int // integer pence, never float
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Effectively a singleton row (query by a known id, e.g. "default").
model CutoffConfig {
  id         String   @id @default("default")
  leadDays   Int      @default(1)
  cutoffTime String // "HH:MM" 24h, interpreted in `timezone`
  timezone   String   @default("Europe/London")
  updatedAt  DateTime @updatedAt
}

model Order {
  id String @id @default(uuid())

  // No single deliveryDate here — each meal in the order can be delivered
  // on a different day (see OrderItem.deliveryDate). One order = one
  // payment/contact/address, potentially spanning several delivery days.

  planId               String
  plan                 Plan   @relation(fields: [planId], references: [id])
  planLabelSnapshot    String
  planPriceGbpSnapshot Int

  contactName    String
  contactPhone   String
  contactEmail   String
  deliveryAddress String

  // Free-text, whole-order notes (e.g. dietary restrictions) captured once
  // at checkout — not per-meal.
  notes String?

  // Defaults to stripe so existing historical rows (all Stripe orders,
  // this being the first non-Stripe path) backfill correctly.
  paymentMethod PaymentMethod @default(stripe)

  status OrderStatus @default(pending_payment)

  // Nullable: cash orders never create a real Stripe Checkout Session.
  // Postgres allows multiple NULLs in a unique index, so this doesn't
  // collide across cash orders.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId          String
  dish            Dish   @relation(fields: [dishId], references: [id])
  dishNameSnapshot String

  // Which day this specific meal is delivered/picked up on.
  deliveryDate DateTime @db.Date

  // Independent of Order.status — no auto-sync either direction. An order
  // can have some meals fulfilled and others not yet.
  fulfilled Boolean @default(false)

  @@index([orderId])
  @@index([deliveryDate])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
