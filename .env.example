# Copy this file to .env and fill in real values locally.
# Never commit .env — it's already gitignored.

# --- Phase 2: database (Neon Postgres, EU region) ---
DATABASE_URL=

# --- Phase 3: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 4: admin auth ---
# Random long string used to sign admin session cookies (JWT).
SESSION_SECRET=

# Only used as inline args to the one-off admin-bootstrap script, never
# loaded from .env by the running app itself:
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx prisma/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=
